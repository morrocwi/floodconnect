{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodconnect.local/schema/dsva-decision-v0.10.json",
  "title": "DSVA v0.10 finite retained theory-contract disaster decision snapshot",
  "type": "object",
  "required": [
    "question",
    "envelope",
    "information_status",
    "model_invalidated",
    "closures",
    "closure_audit",
    "worlds",
    "disturbances",
    "requirements",
    "actor_information",
    "actions",
    "valid_until",
    "applicability_evidence",
    "dependency_audit",
    "resource_audit",
    "hazard_dependency_audit",
    "verification_contract"
  ],
  "properties": {
    "question": {
      "type": "object",
      "required": [
        "id",
        "task",
        "horizon"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string"
        },
        "horizon": {
          "type": [
            "number",
            "integer",
            "string"
          ]
        }
      }
    },
    "envelope": {
      "type": "object",
      "required": [
        "protected_population",
        "disturbance_envelope",
        "actuation_envelope",
        "trace_semantics",
        "trace_resolution",
        "observation_envelope"
      ],
      "properties": {
        "protected_population": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disturbance_envelope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actuation_envelope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trace_semantics": {
          "const": "discrete_retained"
        },
        "trace_resolution": {
          "type": [
            "number",
            "integer",
            "string"
          ]
        },
        "observation_envelope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "information_status": {
      "enum": [
        "SUPPORTED",
        "UNRESOLVED",
        "CONTRADICTION"
      ]
    },
    "model_invalidated": {
      "type": "boolean"
    },
    "closures": {
      "type": "object",
      "required": [
        "first_order",
        "second_order"
      ],
      "properties": {
        "first_order": {
          "type": "object",
          "required": [
            "information",
            "evidence",
            "state",
            "transition",
            "boundary",
            "capacity",
            "recovery"
          ],
          "additionalProperties": false,
          "properties": {
            "information": {
              "type": "boolean"
            },
            "evidence": {
              "type": "boolean"
            },
            "state": {
              "type": "boolean"
            },
            "transition": {
              "type": "boolean"
            },
            "boundary": {
              "type": "boolean"
            },
            "capacity": {
              "type": "boolean"
            },
            "recovery": {
              "type": "boolean"
            }
          }
        },
        "second_order": {
          "type": "object",
          "required": [
            "applicability",
            "dependency",
            "realizability",
            "execution",
            "requirement",
            "verification"
          ],
          "additionalProperties": false,
          "properties": {
            "applicability": {
              "type": "boolean"
            },
            "dependency": {
              "type": "boolean"
            },
            "realizability": {
              "type": "boolean"
            },
            "execution": {
              "type": "boolean"
            },
            "requirement": {
              "type": "boolean"
            },
            "verification": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "worlds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "disturbances": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "population",
          "op",
          "function",
          "constraint",
          "threshold",
          "horizon",
          "provenance",
          "coverageStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "enum": [
              "eq",
              "ne",
              "ge",
              "gt",
              "le",
              "lt",
              "in",
              "not_in",
              "truthy",
              "falsy"
            ]
          },
          "value": {},
          "bindings": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "constraint": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {},
          "horizon": {
            "type": [
              "number",
              "integer",
              "string"
            ]
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coverageStatus": {
            "const": "COVERED"
          }
        }
      }
    },
    "trace_library": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object"
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "actor",
          "requires_info",
          "lease",
          "effect_time",
          "outcomes",
          "execution_contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "requires_info": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lease": {
            "type": "object",
            "required": [
              "issue",
              "expire"
            ],
            "properties": {
              "issue": {
                "type": [
                  "number",
                  "integer",
                  "string"
                ]
              },
              "expire": {
                "type": [
                  "number",
                  "integer",
                  "string"
                ]
              }
            }
          },
          "effect_time": {
            "type": [
              "number",
              "integer",
              "string"
            ]
          },
          "outcomes": {
            "type": "object"
          },
          "execution_contract": {
            "type": "object",
            "required": [
              "commanded",
              "realized_status",
              "runtime_revalidation_required",
              "runtime_revalidation_status"
            ],
            "properties": {
              "commanded": {
                "type": "string",
                "minLength": 1
              },
              "realized_status": {
                "enum": [
                  "VERIFIED",
                  "BOUNDED"
                ]
              },
              "bound": {},
              "runtime_revalidation_required": {
                "type": "boolean"
              },
              "runtime_revalidation_status": {
                "enum": [
                  "PASS",
                  "NOT_REQUIRED"
                ]
              }
            }
          },
          "future_observation_contract": {
            "type": "object",
            "required": [
              "channel",
              "admitted_outcomes",
              "responses"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "admitted_outcomes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "responses": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "typed_reader": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "Choice",
            "Score",
            "Noul",
            "deterministic"
          ]
        },
        "selected": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "proposed_action": {
      "type": "string"
    },
    "valid_until": {
      "type": [
        "number",
        "integer",
        "string"
      ]
    },
    "closure_audit": {
      "type": "object",
      "required": [
        "first_order",
        "second_order"
      ],
      "additionalProperties": false,
      "properties": {
        "first_order": {
          "type": "object",
          "required": [
            "information",
            "evidence",
            "state",
            "transition",
            "boundary",
            "capacity",
            "recovery"
          ],
          "additionalProperties": false,
          "properties": {
            "information": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "evidence": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "state": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "transition": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "boundary": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "capacity": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "recovery": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            }
          }
        },
        "second_order": {
          "type": "object",
          "required": [
            "applicability",
            "dependency",
            "realizability",
            "execution",
            "requirement",
            "verification"
          ],
          "additionalProperties": false,
          "properties": {
            "applicability": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "dependency": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "realizability": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "execution": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "requirement": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            },
            "verification": {
              "type": "object",
              "required": [
                "spec",
                "input",
                "witness",
                "checker"
              ],
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {},
                "witness": {},
                "checker": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {}
              }
            }
          }
        }
      }
    },
    "applicability_evidence": {
      "type": "object",
      "required": [
        "model_behavior_signatures",
        "observed_behavior_signatures"
      ],
      "properties": {
        "model_behavior_signatures": {
          "type": "array",
          "minItems": 1
        },
        "observed_behavior_signatures": {
          "type": "array",
          "minItems": 1
        },
        "reader": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency_audit": {
      "type": "object",
      "required": [
        "lineage",
        "independence_groups"
      ],
      "properties": {
        "lineage": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "independence_groups": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "resource_audit": {
      "type": "object",
      "properties": {
        "declared_none": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        },
        "action_use": {
          "type": "object"
        }
      }
    },
    "hazard_dependency_audit": {
      "type": "object",
      "required": [
        "components",
        "factorized",
        "factorization_licensed"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "factorized": {
          "type": "boolean"
        },
        "factorization_licensed": {
          "type": "boolean"
        }
      }
    },
    "verification_contract": {
      "type": "object",
      "required": [
        "producer",
        "checker",
        "spec_digest",
        "input_digest",
        "certificate"
      ],
      "properties": {
        "producer": {
          "type": "object",
          "required": [
            "id",
            "implementation_digest",
            "lineage"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "implementation_digest": {
              "type": "string",
              "minLength": 1
            },
            "lineage": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "checker": {
          "type": "object",
          "required": [
            "id",
            "implementation_digest",
            "lineage"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "implementation_digest": {
              "type": "string",
              "minLength": 1
            },
            "lineage": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "spec_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "certificate": {
          "type": "object",
          "required": [
            "kind",
            "witness"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "witness": {}
          }
        }
      }
    }
  }
}
